# 登入：單人使用的密碼，以及用來簽章登入 cookie 的密鑰（SESSION_SECRET 至少 32 字元的隨機字串）
APP_PASSWORD=
SESSION_SECRET=

# 平台網址，用來在 Notion 每筆資料附上「在平台編輯」連結（例如 https://xxx.vercel.app）
APP_URL=

# Notion：internal integration 的 token，以及「專案」資料庫的 data source id
# 沒填時會退回本機 .data/（projects.json），只供本機開發
NOTION_TOKEN=
NOTION_PROJECTS_DATA_SOURCE_ID=b99acfce-7dcd-4619-8c2e-65a4c6fc7df7

# 自動產生 PRD 的 GitHub Actions 另需在 GitHub repo secrets 設定 NOTION_TOKEN 與 CLAUDE_CODE_OAUTH_TOKEN
